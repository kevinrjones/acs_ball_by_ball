# syntax=docker/dockerfile:1

################################################################################
# CI Dockerfile for bbb-api
# Expects pre-built installDist artifacts in bbb-api/build/install/bbb-api
################################################################################
FROM eclipse-temurin:21-jre-alpine AS final

RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    mkdir -p /opt/app/logging /opt/app/logs && \
    chown -R appuser:appgroup /opt/app

WORKDIR /opt/app

COPY bbb-api/build/install/bbb-api /opt/app/
COPY bbb-api/src/main/resources/logback.xml /opt/app/logging/logback.xml

RUN chmod +x /opt/app/bin/* && chown -R appuser:appgroup /opt/app

USER appuser

ENV API_PORT=8081
EXPOSE 8081

ENTRYPOINT ["/opt/app/bin/bbb-api"]
