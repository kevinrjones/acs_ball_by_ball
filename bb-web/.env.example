# Web Server Configuration
WEB_PORT=8080
WEB_HOST=localhost
KTOR_DEVELOPMENT=true

# Backend API Configuration
API_BASE_URL=http://localhost:8081
HTTP_REQUEST_TIMEOUT_MILLIS=60000
HTTP_CONNECT_TIMEOUT_MILLIS=30000
HTTP_SOCKET_TIMEOUT_MILLIS=60000

# OIDC / Identity Server Configuration
OIDC_AUTHORITY=https://ids.local:8443
OIDC_CLIENT_ID=bbweb
OIDC_CLIENT_SECRET=secret
OIDC_REDIRECT_URI=http://localhost:8080/signin-oidc
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
OIDC_CERT_PATH=
